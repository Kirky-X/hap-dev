# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# OS
.DS_Store
Thumbs.db
desktop.ini
# IDE
.vscode/
.idea/
*.swp
*.swo
# Build artifacts
*.tmp
*.bak
*.bak.*
# Qdrant local DB backups (keep the main pre-built DB, exclude backups)
data/*.qdrant.bak*/
!data/harmonyos.qdrant/
# Qdrant runtime lock file (transient — regenerated on each open)
data/harmonyos.qdrant/.lock
# ModelScope cache
.modelscope/
# Test artifacts
.coverage
htmlcov/
# OpenSpec 工作流产物（设计文档，不入仓库）
openspec/
# 测试代码（开发期使用，不入仓库）
tests/
**/tests/
**/test/
# 例外：hap-dev scripts/test/ 是对外子命令实现路径（SKILL.md 承诺 python3 -m scripts.test.cli）
# 实现文件入仓；scripts/test/tests/ 契约测试仍按 **/tests/ 惯例不入仓
!scripts/test/
!scripts/test/*
# Darwin skill 优化产物（开发期使用，不入仓库）
results.tsv
test-prompts.json
darwin-result-card.png
sidebars/
specmark/
# Python cache
*.pyc
.ruff_cache/
# Specmark/openspec 临时产物
